APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:GENERATED_KEY
APP_DEBUG=false
APP_URL=https://nexshop-ff1p.onrender.com/

# Les prix et totaux sont stockés et saisis en francs djiboutiens (Fdj).

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgresql://nexshop_user:YE6Aas018U0Ierk8pK6px0YaASQQKePA@dpg-d7t2so3bc2fs73d9vfgg-a.oregon-postgres.render.com/nexshop
DB_PORT=5432
DB_DATABASE=nexshop
DB_USERNAME=nexshop_user
DB_PASSWORD=YE6Aas018U0Ierk8pK6px0YaASQQKePA

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Laravel Reverb (WebSockets) — lancer : php artisan reverb:start
REVERB_APP_ID=1001
REVERB_APP_KEY=localkey
REVERB_APP_SECRET=secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pour la prod : smtp (+ Gmail app password, Mailgun, etc.). « log » = pas d’email réel, uniquement laravel.log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Alertes admin (KYC, formulaire contact, etc.)
MAIL_ADMIN_ADDRESS="admin@example.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
